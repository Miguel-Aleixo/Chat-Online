generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model usuario {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  role     Role      @default(USER)

  mensagens mensagem[]
}

model mensagem {
  id        Int      @id @default(autoincrement())
  text      String
  userId    Int
  usuario   usuario  @relation(fields: [userId], references: [id])
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt DateTime?  
}
